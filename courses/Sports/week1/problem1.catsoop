csq_soln = 'An indirect free kick to the opposing team at the spot of the infringement'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'In football, when a player is injured during open play, the referee:'
