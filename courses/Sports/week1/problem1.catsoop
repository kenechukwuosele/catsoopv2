<question multiplechoice>
csq_prompt = 'A forward receives the ball when he is level with the last defender. Is he offside?'
csq_options = ['Yes, because he is near the goal', 'No, because being level with the last defender means he is onside', "Yes, because he is in the opponent's half", 'No, if the ball was played to him by an opponent']
csq_soln = 'No, because being level with the last defender means he is onside'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
