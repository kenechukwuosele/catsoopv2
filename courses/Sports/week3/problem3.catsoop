<question multiplechoice>
csq_prompt = 'Team A wins a rally but was receiving serve. What happens?'
csq_options = ['Team A gets the point and wins the serve (side out)', 'Team B gets the point', 'Team A gets the point but Team B keeps the serve', 'No point is awarded — only servers can score']
csq_soln = 'Team A gets the point and wins the serve (side out)'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = "A setter touches the ball on a team's second contact, using an overhand two-handed contact to send it to a hitter. This is called a:"
