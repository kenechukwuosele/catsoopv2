<style>
        .panel {
            flex: 1;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f9f9f9;
        }
        
        h1, h2, h3 {
            color: #2c3e50;
        }
        
        button {
            background-color: #4CAF50;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin: 5px 0;
            font-size: 14px;
        }
        
        button:hover {
            background-color: #45a049;
        }
        
        button:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
        }
        
        input[type="text"], input[type="file"], textarea, select {
            width: 100%;
            padding: 8px;
            margin: 5px 0;
            display: inline-block;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        
        .question-form {
            margin-bottom: 20px;
        }
        
        .option-group {
            margin: 10px 0;
        }
        
        .option-input {
            display: flex;
            margin-bottom: 5px;
        }
        
        .option-input input[type="text"] {
            flex-grow: 1;
            margin-right: 10px;
        }
        
        #questionsDisplay, #quizContainer {
            margin-top: 20px;
        }
        
        .question-block {
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 5px;
            background-color: white;
        }
        
        .question-title {
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .question-option {
            margin: 5px 0;
        }
        
        .feedback {
            margin-top: 10px;
            padding: 10px;
            border-radius: 4px;
            display: none;
        }
        
        .correct {
            background-color: #d4edda;
            color: #155724;
        }
        
        .incorrect {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .tab {
            overflow: hidden;
            border: 1px solid #ccc;
            background-color: #f1f1f1;
            border-radius: 5px 5px 0 0;
        }
        
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            color: #333;
        }
        
        .tab button:hover {
            background-color: #ddd;
        }
        
        .tab button.active {
            background-color: #4CAF50;
            color: white;
        }
        
        .tabcontent {
            display: none;
            padding: 20px;
            border: 1px solid #ccc;
            border-top: none;
            border-radius: 0 0 5px 5px;
        }
        
        .action-buttons {
            margin-top: 15px;
            display: flex;
            justify-content: space-between;
        }
        
        .results-container {
            margin-top: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f0f7ff;
        }
        
        #attemptsList ul {
            list-style-type: none;
            padding: 0;
        }
        
        #attemptsList li {
            margin-bottom: 15px;
            padding: 10px;
            background-color: white;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        #performanceTable {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
        }

        #performanceTable th,
        #performanceTable td {
            padding: 10px;
            text-align: center;
            vertical-align: middle;
        }
</style>

<div class="tab">
    <button class="tablinks active" onclick="openTab(event, 'createTab')">Create Questions</button>
    <button class="tablinks" onclick="openTab(event, 'takeTab')">Take Quiz</button>
    <button class="tablinks" onclick="openTab(event, 'importExportTab')">Import/Export</button>
    <button class="tablinks" onclick="openTab(event, 'performanceTab')">Student Performance</button>
</div>


<div id="createTab" class="tabcontent" style="display: block;">
    <h2>Create Quiz Questions</h2>     
    <div class="question-form">
        <h3>New Question</h3>
        <label for="questionText">Question:</label>
        <textarea id="questionText" rows="3" placeholder="Enter your question here"></textarea>         
        <label for="questionType">Question Type:</label>
        <select id="questionType" onchange="handleQuestionTypeChange()">
            <option value="multiple-choice">Multiple Choice</option>
            <option value="checkbox">Multiple Select</option>
            <option value="short-answer">Short Answer</option>
        </select>          
        <div id="options-container">
            <h4>Options</h4>
            <div class="option-group" id="optionsGroup">
                <div class="option-input">
                    <input type="text" placeholder="Option 1" class="option-text">
                    <input type="radio" name="correctOption" class="correctOption" checked>
                    <label>Correct</label>
                </div>
                <div class="option-input">
                    <input type="text" placeholder="Option 2" class="option-text">
                    <input type="radio" name="correctOption" class="correctOption">
                    <label>Correct</label>
                </div>
            </div>
            <button type="button" onclick="addOption()">Add Option</button>
        </div>          
        <div id="short-answer-container" style="display: none;">
            <label for="shortAnswer">Correct Answer:</label>
            <input type="text" id="shortAnswer" placeholder="Enter the correct answer">
        </div>           
        <div class="action-buttons">
            <input type="hidden" id="csrf_token" value="{{ csrf_token }}">
            <button type="button" onclick="addQuestion(event)" id="submitQuestionBtn">Add Question</button>
            <button type="button" onclick="clearForm()">Clear Form</button>
        </div>          
    </div>        
    <h3>Current Questions</h3>
    <div id="questionsDisplay">
        <p>No questions added yet.</p>
    </div>      
</div>
   
<div id="takeTab" class="tabcontent">
    <div id="quizContainer">
        <p>No questions available. Create some questions first!</p>
    </div>
    <div class="action-buttons">
        <button id="submitQuizBtn" onclick="submitQuiz()" style="display: none;">Submit Quiz</button>
    </div>
    <div id="resultsContainer" class="results-container" style="display: none;">
        <h3>Quiz Results</h3>
        <p id="scoreDisplay"></p>
        <div id="detailedResults"></div>
    </div>
    <div id="previousAttemptsContainer" class="results-container" style="display: none;">
        <h3>Your Previous Attempts</h3>
        <div id="attemptsList"></div>
    </div>
</div>
 
<div id="importExportTab" class="tabcontent">
    <h2>Import/Export Quiz</h2>      
    <div class="panel">
        <h3>Export Quiz</h3>
        <p>Download your current quiz as a JSON file:</p>
        <button onclick="exportQuiz()">Export Quiz</button>
    </div> 
    <div class="panel">
        <h3>Import Quiz</h3>
        <p>Upload a previously exported quiz file:</p>
        <input type="file" id="importFile" accept=".json">
        <button onclick="importQuiz()">Import Quiz</button>
    </div>
</div>  

<div id="performanceTab" class="tabcontent">
    <h2>Student Performance</h2>
    <div id="performanceTableContainer">
        <table id="performanceTable" border="1" cellpadding="8">
            <thead>
            <tr>
        <th>Student Name</th>
        <th>Score</th>
        <th>Date Taken</th>
        <th>Total Questions</th>
        <th>Percentage</th>
        <th>Time Spent</th> 
        <th>Clicks</th>
        </tr>
            </thead>
            <tbody id="otbody">
                <tr>
                    <td colspan="5">No performance data available yet.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<script>
    // --- 1. CONFIGURATION ---
    var course = 'Sports'; 
    var week = 'week3'; 
    const serverIp = 'http://172.31.184.39:8000';
    const apiBase = `${serverIp}/${course}/${week}/example_questions`;
    const attemptUrl = `${serverIp}/${course}/${week}/submit_attempt`;

    // Initialize WebSocket
    // This cleans the IP so it doesn't have 'http://' inside the 'ws://' string
    const socketAddress = serverIp.replace('http://', '').replace('https://', '');
    const socket = new WebSocket(`ws://${socketAddress}/ws`);

    socket.onmessage = (event) => {
    const data = JSON.parse(event.data);
    // If a new submission is broadcast, refresh the performance table
    if (data.type === 'NEW_SUBMISSION' && userRole !== 'Student') {
        loadPerformance();
        }
    };

    // --- METRICS CONFIGURATION ---
let activeStartTime = Date.now();
let totalActiveSeconds = 0;
let pageClicks = 0;
let lastInteractionTime = Date.now();
const IDLE_THRESHOLD = 60000; // 1 minute of no movement = idle

// Track clicks globally for the "Page Clicks" metric
document.addEventListener('click', () => {
    pageClicks++;
    lastInteractionTime = Date.now(); 
});

// Update active time only if tab is focused and user isn't idle
setInterval(() => {
    const now = Date.now();
    const isTabActive = !document.hidden;
    const isNotIdle = (now - lastInteractionTime) < IDLE_THRESHOLD;

    if (isTabActive && isNotIdle) {
        totalActiveSeconds += 1;
    }
}, 1000);

// Record interaction for idle detection
['mousemove', 'keydown', 'scroll', 'touchstart'].forEach(evt => {
    document.addEventListener(evt, () => { lastInteractionTime = Date.now(); });
});

    // Global variable to hold questions for the quiz tab
    let activeQuestions = [];

    // --- 2. CORE LOGIC (CREATION) ---
    function handleQuestionTypeChange() {
        const type = document.getElementById('questionType').value;
        document.getElementById('options-container').style.display = type === 'short-answer' ? 'none' : 'block';
        document.getElementById('short-answer-container').style.display = type === 'short-answer' ? 'block' : 'none';
        
        document.querySelectorAll('.correctOption').forEach(el => {
            el.type = (type === 'checkbox') ? 'checkbox' : 'radio';
        });
    }

    function addOption() {
        const div = document.createElement('div');
        div.className = 'option-input';
        const type = document.getElementById('questionType').value === 'checkbox' ? 'checkbox' : 'radio';
        div.innerHTML = `<input type="text" placeholder="New Option" class="option-text"> <input type="${type}" name="correctOption" class="correctOption"> Correct`;
        document.getElementById('optionsGroup').appendChild(div);
    }

    // --- UTILITY FUNCTIONS ---

function clearForm() {
    // Clears the textarea and resets the question type
    document.getElementById('questionText').value = "";
    document.getElementById('questionType').selectedIndex = 0;
    document.getElementById('shortAnswer').value = "";
    
    // Reset options to default two blanks
    const optionsGroup = document.getElementById('optionsGroup');
    optionsGroup.innerHTML = `
        <div class="option-input">
            <input type="text" placeholder="Option 1" class="option-text">
            <input type="radio" name="correctOption" class="correctOption" checked>
            <label>Correct</label>
        </div>
        <div class="option-input">
            <input type="text" placeholder="Option 2" class="option-text">
            <input type="radio" name="correctOption" class="correctOption">
            <label>Correct</label>
        </div>`;
    handleQuestionTypeChange();
}

async function exportQuiz() {
    // Fetches the current questions and triggers a JSON download
    const resp = await fetch(apiBase);
    const questions = await resp.json();
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(questions));
    const downloadAnchorNode = document.createElement('a');
    downloadAnchorNode.setAttribute("href", dataStr);
    downloadAnchorNode.setAttribute("download", `${course}_${week}_quiz.json`);
    document.body.appendChild(downloadAnchorNode);
    downloadAnchorNode.click();
    downloadAnchorNode.remove();
}

async function importQuiz() {
    const fileInput = document.getElementById('importFile');
    if (!fileInput.files.length) return alert("Please select a file first");
    
    const file = fileInput.files[0];
    const reader = new FileReader();
    reader.onload = async (e) => {
        const questions = JSON.parse(e.target.result);
        // Loop through and save each question to the backend
        for (const q of questions) {
            await fetch(apiBase, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    action: 'save_question',
                    username: userName,
                    text: q.text,
                    type: q.qtype,
                    options: q.options || [],
                    correctAnswers: q.correct_answers,
                    course: course,
                    week: week
                })
            });
        }
        alert("Import complete!");
        updateQuestionsDisplay();
    };
    reader.readAsText(file);
}

    async function addQuestion(e) {
        if(e) e.preventDefault();
        const text = document.getElementById('questionText').value;
        const type = document.getElementById('questionType').value;
        let options = [];
        let correctAnswers = [];

        if (type === 'short-answer') {
            correctAnswers = [document.getElementById('shortAnswer').value];
        } else {
            document.querySelectorAll('.option-input').forEach((div, i) => {
                const val = div.querySelector('.option-text').value;
                if(val) {
                    options.push(val);
                    if(div.querySelector('.correctOption').checked) correctAnswers.push(i);
                }
            });
        }

        const payload = {
            username: userName,
            text: text,
            type: type,
            options: options,
            correctAnswers: correctAnswers,
            course: course,
            week: week
        };

        const resp = await fetch(apiBase, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({action: 'save_question', ...payload})
        });
        
        if (resp.ok) {
            alert("Saved!");
            updateQuestionsDisplay();
        }
    }

    async function updateQuestionsDisplay() {
    const container = document.getElementById('questionsDisplay');
    try {
        const resp = await fetch(apiBase);
        const questions = await resp.json();
        
        // Safety Check: Ensure 'questions' is an array
        if (!Array.isArray(questions)) {
        console.error("Server Error:", questions.detail);
        document.getElementById('questionsDisplay').innerHTML = 
            `<p style="color:red">Server Error: ${questions.detail}</p>`;
        return;
    }

        container.innerHTML = questions.map((q, i) => `
            <div class="question-block">
                <b>${i+1}. ${q.text}</b> (${q.qtype})
                <button onclick="deleteQuestion(${q.id})">Delete</button>
            </div>
        `).join('');
    } catch(e) { 
        container.innerHTML = "No questions found or server is offline."; 
    }
}

    // --- 3. TAKE QUIZ LOGIC ---
    async function renderQuiz() {
        const container = document.getElementById('quizContainer');
        const resp = await fetch(apiBase);
        activeQuestions = await resp.json(); // Store in global variable
        
        if(activeQuestions.length === 0) {
            container.innerHTML = "No questions available.";
            return;
        }

        container.innerHTML = activeQuestions.map((q, i) => {
            let inputHtml = '';
            if (q.qtype === 'short-answer') {
                // Fixed ID to use backticks for template literals
                inputHtml = `<input type="text" id="ans-${q.id}" class="quiz-ans">`;
            } else {
                inputHtml = q.options.map((opt, optIdx) => `
                    <div>
                        <input type="${q.qtype === 'checkbox' ? 'checkbox' : 'radio'}" 
                               name="q-${q.id}" value="${optIdx}" class="quiz-ans"> 
                        ${opt}
                    </div>
                `).join('');
            }
            return `<div class="question-block"><b>${i+1}. ${q.text}</b><br>${inputHtml}<div id="feed-${q.id}" class="feedback"></div></div>`;
        }).join('');
        
        document.getElementById('submitQuizBtn').style.display = 'block';
    }

    // NEW: Defined the missing submitQuiz function
    async function submitQuiz() {
    let score = 0;
    const results = [];

    activeQuestions.forEach(q => {
        let isCorrect = false;
        let userVal = "";
        if(q.qtype === 'short-answer') {
            userVal = document.getElementById(`ans-${q.id}`).value.trim();
            isCorrect = userVal.toLowerCase() === q.correct_answers[0].toLowerCase();
        } else {
            const selected = Array.from(document.querySelectorAll(`input[name="q-${q.id}"]:checked`)).map(el => parseInt(el.value));
            isCorrect = JSON.stringify(selected.sort()) === JSON.stringify(q.correct_answers.sort());
            userVal = selected.map(idx => q.options[idx]).join(', ');
        }
        if(isCorrect) score++;
        const feed = document.getElementById(`feed-${q.id}`);
        feed.style.display = 'block';
        feed.innerHTML = isCorrect ? "✅ Correct" : "❌ Incorrect";
        feed.className = "feedback " + (isCorrect ? "correct" : "incorrect");
        results.push({ question: q.text, userAnswer: userVal, isCorrect: isCorrect });
    });

    const engagementMetrics = {
        secondsSpent: totalActiveSeconds,
        clickCount: pageClicks,
        exitTime: new Date().toISOString()
    };

    // Update payload to include engagement
    const payload = { 
        username: userName, 
        score: score, 
        total: activeQuestions.length, 
        course: course, 
        week: week, 
        results: results,
        metrics: engagementMetrics // <--- Added this
    };

    const resp = await fetch(attemptUrl, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload)
    });

    if (resp.ok && socket.readyState === WebSocket.OPEN) {
        socket.send(JSON.stringify({ type: 'NEW_SUBMISSION', student: userName }));
    }

    // Reset metrics for next attempt if needed
    totalActiveSeconds = 0;
    pageClicks = 0;

    document.getElementById('resultsContainer').style.display = 'block';
    document.getElementById('scoreDisplay').innerText = `You scored ${score} / ${activeQuestions.length}`;

   

    // NEW: Notify the WebSocket that a submission just happened
    if (resp.ok && socket.readyState === WebSocket.OPEN) {
        socket.send(JSON.stringify({ type: 'NEW_SUBMISSION', student: userName }));
    }

    document.getElementById('resultsContainer').style.display = 'block';
    document.getElementById('scoreDisplay').innerText = `You scored ${score} / ${activeQuestions.length}`;
    }

    // --- 4. TABS & INIT ---
    // NEW: Function to load all student attempts for the performance table
async function loadPerformance() {
    const tableBody = document.getElementById('otbody');
    const performanceUrl = `${serverIp}/${course}/${week}/all_attempts`;
    
    try {
        const resp = await fetch(performanceUrl);
        const data = await resp.json();
        
        if (!data.attempts || data.attempts.length === 0) {
            tableBody.innerHTML = '<tr><td colspan="5">No performance data available yet for ' + course + ' ' + week + '.</td></tr>';
            return;
        }

        // Map the database attempts to table rows
        tableBody.innerHTML = data.attempts.map(a => {
            const percentage = Math.round((a.score / a.total) * 100);
            const mins = Math.floor((a.seconds_spent || 0) / 60);
            const secs = (a.seconds_spent || 0) % 60;
            const timeSpent = `${mins}m ${secs}s`;
            return `
                <tr>
                <td>${a.username || 'Anonymous'}</td>
            <td>${a.score} / ${a.total}</td>
            <td>${new Date(a.submitted_at).toLocaleString()}</td>
            <td>${a.total}</td>
            <td>${percentage}%</td>
            <td>${timeSpent}</td>
            <td>${a.click_count || 0} clicks
            </td>
                </tr>
            `;
        }).join('');
    } catch (e) {
        console.error("Failed to load performance:", e);
        tableBody.innerHTML = '<tr><td colspan="5">Error connecting to performance server.</td></tr>';
    }
}

// UPDATE: Modify the openTab function to trigger the load
function openTab(evt, tabName) {
    document.querySelectorAll(".tabcontent").forEach(t => t.style.display = "none");
    document.querySelectorAll(".tablinks").forEach(t => t.classList.remove("active"));
    document.getElementById(tabName).style.display = "block";
    if(evt) evt.currentTarget.classList.add("active");
    
    if(tabName === 'takeTab') renderQuiz();
    
    // Trigger performance load when the specific tab is clicked
    if(tabName === 'performanceTab') loadPerformance();
}

   window.onload = () => {
    updateQuestionsDisplay();
    
    if(userRole === 'Student') {
        // 1. Hide the "Create Questions" tab content and button
        document.getElementById('createTab').style.display = 'none';
        document.querySelector('[onclick*="createTab"]').style.display = 'none';
        
        // 2. Hide the "Import/Export" tab button
        document.querySelector('[onclick*="importExportTab"]').style.display = 'none';
        
        // 3. Hide the "Student Performance" tab button
        document.querySelector('[onclick*="performanceTab"]').style.display = 'none';
        
        // 4. Force the student into the "Take Quiz" tab
        openTab(null, 'takeTab');
    }
};
</script>