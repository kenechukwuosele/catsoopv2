from datetime import datetime



#print(cs_session_data)
# Initialize database
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(cs_data_root)), "catsoop/courses/Programming/week1/catsoop.db")
# Set content type for AJAX responses

# Set content type and headers for regular page load
