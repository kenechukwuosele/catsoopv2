<python>
cs_content_header = 'Week 3 Practice Problems: Work, Energy & Power'
</python>

<question multiplechoice>
csq_prompt = 'A force of 50 N pushes a box 10 m along a frictionless floor. How much work is done?'
csq_options = ['500 J', '60 J', '5 J', '5000 J']
csq_soln = '500 J'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'A 2 kg object moves at 6 m/s. What is its kinetic energy?'
csq_options = ['12 J', '36 J', '24 J', '6 J']
csq_soln = '36 J'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'A 5 kg ball is raised to a height of 4 m (g = 10 m/s²). What is its gravitational potential energy?'
csq_options = ['20 J', '200 J', '50 J', '400 J']
csq_soln = '200 J'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'A machine does 1500 J of work in 30 seconds. What is its power output?'
csq_options = ['50 W', '45000 W', '1500 W', '0.02 W']
csq_soln = '50 W'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'A roller coaster car starts from rest at the top of a 20 m hill (g = 10 m/s²). Assuming no friction, what is its speed at the bottom?'
csq_options = ['10 m/s', '20 m/s', '40 m/s', '200 m/s']
csq_soln = '20 m/s'
csq_renderer = 'radio'
