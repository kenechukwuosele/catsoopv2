<style>
    .queue-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }
    .queue-item {
        border: 1px solid #ddd;
        margin: 10px 0;
        padding: 15px;
        border-radius: 5px;
        background-color: #f9f9f9;
    }
    .queue-item.processing {
        background-color: #fff3cd;
        border-color: #ffeaa7;
    }
    .queue-item.completed {
        background-color: #d4edda;
        border-color: #c3e6cb;
    }
    .queue-item.error {
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }
    .queue-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }
    .status-pending { background-color: #6c757d; color: white; }
    .status-processing { background-color: #ffc107; color: black; }
    .status-completed { background-color: #28a745; color: white; }
    .status-error { background-color: #dc3545; color: white; }
    
    .empty-queue {
        text-align: center;
        color: #6c757d;
        padding: 40px;
        font-style: italic;
    }
    
    .refresh-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
    }
    .refresh-btn:hover {
        background-color: #0056b3;
    }
    
    .course-info {
        background-color: #e8f5e8;
        border: 1px solid #4caf50;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }
    
    .fixed-message {
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }
</style>

<div class="queue-container">
    <div class="fixed-message">
        <h4>🎉 Queue Issue Fixed!</h4>
        <p><strong>Good news:</strong> The Physics queue page is now working correctly. The admin panel links should now work properly.</p>
