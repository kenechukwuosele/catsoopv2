            </ul>
        </div>
    </div>
</div>

<script>
console.log('Biology queue page loaded successfully');

// Add some sample data to show this is working
const sampleQueueData = [
    {
        id: 1,
        student: "student_demo",
        quiz: "Biology Cell Structure Quiz",
        status: "completed",
        submitted: "2026-03-28 10:15:00",
        processed: "2026-03-28 10:16:30",
        score: "7/10",
        affectData: {
            frustration: 0.3,
            confidence: 0.7,
            engagement: 0.8,
            confusion: 0.2
        }
    }
];

// Function to render queue (can be activated for demo)
function renderSampleQueue() {
    const queueList = document.getElementById('queueList');
    
    let html = '<h4>📊 Sample Queue Data (Demo)</h4>';
    sampleQueueData.forEach(item => {
        html += `
            <div class="queue-item ${item.status}">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong>${item.student}</strong> - ${item.quiz}
                        <br>
                        <small>Submitted: ${item.submitted}</small>
                        <br><small>Processed: ${item.processed}</small>
                        <br><small>Score: ${item.score}</small>
                        <br><small>Affect: Frustration ${Math.round(item.affectData.frustration*100)}%, Confidence ${Math.round(item.affectData.confidence*100)}%</small>
                    </div>
                    <span class="status-badge status-${item.status}">${item.status}</span>
                </div>
                <div style="margin-top: 10px; font-size: 12px; color: #666;">
                    Queue ID: ${item.id} | Affect-aware processing enabled ✓
                </div>
            </div>
        `;
    });
    
    html += '<p style="margin-top: 15px;"><button onclick="location.reload()">Show Empty Queue</button> <button onclick="renderSampleQueue()">Show Sample Data</button></p>';
    
    queueList.innerHTML = html;
}

// Add button to show sample data
setTimeout(() => {
    const queueList = document.getElementById('queueList');
    queueList.innerHTML += '<br><p><button onclick="renderSampleQueue()" style="background-color: #28a745; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer;">🎮 Show Sample Queue Data</button></p>';
}, 1000);
</script>