<python>
cs_content_header = 'Week 1 Practice Problems: The Richest Man in Babylon'
</python>

<question multiplechoice>
csq_prompt = "Kobi saves ₦1,000 per month. He keeps ₦900 for all his expenses and saves ₦100. Which principle from 'The Richest Man in Babylon' is he applying?"
csq_options = ['The Five Laws of Gold', 'Pay Yourself First (save 10% of income)', 'The Clay Tablets debt plan', 'The Golden Opportunity principle']
csq_soln = 'Pay Yourself First (save 10% of income)'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = "Temi invests ₦50,000 in a scheme that promises to double her money in a week with no risk. According to the book's wisdom, she should:"
csq_options = ['Invest immediately to get rich fast', 'Decline, because quick-rich schemes violate the laws of gold', 'Borrow more money to invest more', 'Ask her friends to invest too']
csq_soln = 'Decline, because quick-rich schemes violate the laws of gold'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'If you earn ₦200,000 a month but spend ₦210,000, which lesson from the book are you violating?'
csq_options = ['The law of compound interest', 'The goddess of luck', 'Live on less than you earn', 'The clay tablets plan']
csq_soln = 'Live on less than you earn'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = "According to the book, which of the following best helps money 'breed' more money?"
csq_options = ['Spending on luxury to show wealth', 'Keeping cash under the mattress', 'Investing savings so that earnings also earn returns (compound growth)', 'Lending money to friends freely']
csq_soln = 'Investing savings so that earnings also earn returns (compound growth)'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = "A key difference between a 'fat purse' and a 'lean purse' in the book is:"
csq_options = ['The fat purse owner earns more money', 'The fat purse grows because its owner systematically saves and invests; the lean purse shrinks through undisciplined spending', 'The fat purse owner inherited wealth', 'The lean purse owner is unlucky']
csq_soln = 'The fat purse grows because its owner systematically saves and invests; the lean purse shrinks through undisciplined spending'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>
