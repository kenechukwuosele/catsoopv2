<python>
cs_content_header = "Week 1 Practice Problems: Personal Finance Fundamentals"
</python>

<style>
  body { font-family: Arial, sans-serif; padding: 20px; background: #f9f9f9; }
  .card { background: white; border: 1px solid #ccc; padding: 16px; margin-bottom: 30px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
  .correct { color: green; font-weight: bold; }
  .incorrect { color: red; font-weight: bold; }
  input[type="text"] { width: 100%; padding: 8px; margin-top: 10px; box-sizing: border-box; }
  button { margin-top: 10px; padding: 8px 16px; cursor: pointer; }
</style>

<!-- Example -->
<div class="card">
  <h2>Example: Savings Rate Calculation</h2>
  <p>If you earn ₦80,000 per month and follow the "pay yourself first" principle by saving 10%, your monthly savings amount is:</p>
  <p><code>Savings = 10% × ₦80,000 = ₦8,000 per month</code></p>
  <p>Over 12 months, that is ₦96,000 saved — without touching any investment growth.</p>
</div>

<!-- Question 1 -->
<div class="card">
  <h2>Question 1</h2>
  <p><strong>Question:</strong> According to the first cure, what minimum percentage of your income should you save before spending on anything else?</p>
  <input type="text" id="answer1" placeholder="Type your answer here (e.g. 10%)">
  <button onclick="checkAnswer('answer1', 'result1', '10%')">Submit</button>
  <div id="result1"></div>
</div>

<!-- Question 2 -->
<div class="card">
  <h2>Question 2</h2>
  <p><strong>Question:</strong> You earn ₦150,000 per month. If you save 10% first and budget the rest, how much is available for all your expenses?</p>
  <input type="text" id="answer2" placeholder="Type your answer here (in ₦)">
  <button onclick="checkAnswer('answer2', 'result2', '₦135,000')">Submit</button>
  <div id="result2"></div>
</div>

<!-- Question 3 -->
<div class="card">
  <h2>Question 3</h2>
  <p><strong>Question:</strong> Compound interest means you earn interest on both your principal and the _____ already accumulated. Fill in the blank.</p>
  <input type="text" id="answer3" placeholder="Type your answer here">
  <button onclick="checkAnswer('answer3', 'result3', 'interest')">Submit</button>
  <div id="result3"></div>
</div>

<!-- Question 4 -->
<div class="card">
  <h2>Question 4</h2>
  <p><strong>Question:</strong> An investment scheme promises you a 100% return in 30 days with no risk. According to the fourth cure, what should you do?</p>
  <input type="text" id="answer4" placeholder="Type your answer here">
  <button onclick="checkAnswer('answer4', 'result4', 'avoid it')">Submit</button>
  <div id="result4"></div>
</div>

<!-- Question 5 -->
<div class="card">
  <h2>Question 5</h2>
  <p><strong>Question:</strong> The seventh cure advises you to increase your ability to earn by continuously investing in your own ______.</p>
  <input type="text" id="answer5" placeholder="Type your answer here">
  <button onclick="checkAnswer('answer5', 'result5', 'skills')">Submit</button>
  <div id="result5"></div>
</div>

<script>
  function checkAnswer(inputId, resultId, correctAnswer) {
    const userInput = document.getElementById(inputId).value.trim().toLowerCase();
    const resultDiv = document.getElementById(resultId);
    const expected = correctAnswer.toLowerCase();
    if (userInput === expected) {
      resultDiv.innerHTML = '<p class="correct">&#10003; Correct!</p>';
    } else {
      resultDiv.innerHTML = '<p class="incorrect">&#10007; Incorrect.</p><p>The correct answer is: <code>' + correctAnswer + '</code></p>';
    }
  }
</script>
