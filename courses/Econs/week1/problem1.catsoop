<python>
cs_content_header = 'Week 1 Practice Problems: Demand and Supply'
</python>

<question multiplechoice>
csq_prompt = 'A new study shows that coffee is beneficial to health. Which of the following is the most likely immediate market effect for coffee?'
csq_options = ['The supply of coffee increases', 'The demand for coffee increases, raising price', 'The price of coffee falls due to overproduction', 'The demand for tea increases']
csq_soln = 'The demand for coffee increases, raising price'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'If the price of beef rises significantly, what would you expect to happen to the demand for chicken (a substitute)?'
csq_options = ['It decreases', 'It stays the same', 'It increases', 'It fluctuates randomly']
csq_soln = 'It increases'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'A government sets a price ceiling of ₦500 on a good whose equilibrium price is ₦800. This will most likely cause:'
csq_options = ['A surplus of the good', 'A shortage of the good', 'No effect on the market', 'Higher supply of the good']
csq_soln = 'A shortage of the good'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'Which of the following scenarios describes a movement ALONG the demand curve (not a shift)?'
csq_options = ['Consumer incomes rise, so more of the good is purchased', "The good's own price falls, so more is demanded", "A substitute's price falls, reducing demand", 'Tastes change in favour of the good']
csq_soln = "The good's own price falls, so more is demanded"
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
csq_prompt = 'If supply increases while demand remains constant, the equilibrium price will:'
csq_options = ['Rise', 'Fall', 'Stay the same', 'First rise then fall']
csq_soln = 'Fall'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>
