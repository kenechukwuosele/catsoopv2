<python>
cs_content_header = "Programming Examples and Practice Problems"
</python>


<style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      background: #f9f9f9;
    }
    .card {
      background: white;
      border: 1px solid #ccc;
      padding: 16px;
      margin-bottom: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .correct {
      color: green;
      font-weight: bold;
    }
    .incorrect {
      color: red;
      font-weight: bold;
    }
    input[type="text"] {
      width: 100%;
      padding: 8px;
      margin-top: 10px;
    }
    button {
      margin-top: 10px;
      padding: 8px 16px;
    }
  </style>


<!-- Example 1 -->
<div class="card">
  <h2>Example 1</h2>
  <p><strong>Example:</strong></p>
  <pre>print("My name is Ada Lovelace")</pre>

  <p><strong>Question:</strong> Write the Python code to print: <code>I love programming</code></p>

  <input type="text" id="answer1" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer1', 'result1', 'print(&quot;I love programming&quot;)')">Submit</button>
  <div id="result1"></div>
</div>

<!-- Example 2 -->
<div class="card">
  <h2>Example 2</h2>
  <p><strong>Example:</strong></p>
  <pre>print("Hello, world!")</pre>

  <p><strong>Question:</strong> Write the Python code to print: <code>Welcome to Python</code></p>

  <input type="text" id="answer2" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer2', 'result2', 'print(&quot;Welcome to Python&quot;)')">Submit</button>
  <div id="result2"></div>
</div>

<!-- Example 3 -->
<div class="card">
  <h2>Example 3</h2>
  <p><strong>Example:</strong></p>
  <pre>print("2 + 2 =", 2 + 2)</pre>

  <p><strong>Question:</strong> Write the Python code to print: <code>The result is 10</code></p>

  <input type="text" id="answer3" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer3', 'result3', 'print(&quot;The result is 10&quot;)')">Submit</button>
  <div id="result3"></div>
</div>

<!-- Example 4 -->
<div class="card">
  <h2>Example 4</h2>
  <p><strong>Example:</strong></p>
  <pre>name = "Ada"
print("Hello", name)</pre>

  <p><strong>Question:</strong> Write the Python code to store your name in a variable called <code>my_name</code> and print <code>Hello</code> followed by your name.</p>

  <input type="text" id="answer4" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer4', 'result4', 'my_name = &quot;YourName&quot;; print(&quot;Hello&quot;, my_name)', true)">Submit</button>
  <div id="result4"></div>
</div>

<script>
  function checkAnswer(inputId, resultId, correctAnswer, isFlexible = false) {
    const userInput = document.getElementById(inputId).value.trim();
    const resultDiv = document.getElementById(resultId);
    let normalizedUserInput = userInput.replace(/\s+/g, '').toLowerCase();
    let normalizedCorrectAnswer = correctAnswer.replace(/\s+/g, '').toLowerCase();

    if (isFlexible) {
      if (normalizedUserInput.includes("my_name=") && normalizedUserInput.includes("print(\"hello\",my_name)")) {
        resultDiv.innerHTML = '<p class="correct">✅ Correct!</p>';
      } else {
        resultDiv.innerHTML = `<p class="incorrect">❌ Incorrect.</p><p>The correct format is:<br><code>my_name = "YourName"<br>print("Hello", my_name)</code></p>`;
      }
    } else {
      if (normalizedUserInput === normalizedCorrectAnswer) {
        resultDiv.innerHTML = '<p class="correct">✅ Correct!</p>';
      } else {
        resultDiv.innerHTML = `<p class="incorrect">❌ Incorrect.</p><p>The correct answer is: <code>${correctAnswer}</code></p>`;
      }
    }
  }
</script>
