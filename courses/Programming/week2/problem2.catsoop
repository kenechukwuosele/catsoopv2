<python>
cs_content_header = "Basic Concepts Quiz and Practice Problems"
</python>


<style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      background: #f9f9f9;
    }
    .card {
      background: white;
      border: 1px solid #ccc;
      padding: 16px;
      margin-bottom: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .correct {
      color: green;
      font-weight: bold;
    }
    .incorrect {
      color: red;
      font-weight: bold;
    }
    input[type="text"] {
      width: 100%;
      padding: 8px;
      margin-top: 10px;
    }
    button {
      margin-top: 10px;
      padding: 8px 16px;
    }
  </style>


<!-- Example 1 -->
<div class="card">
  <h2>Example 1: Variables</h2>
  <p><strong>Example:</strong></p>
  <pre>age = 25
print("I am", age, "years old")</pre>

  <p><strong>Question:</strong> Write Python code to create a variable called <code>score</code> with value 85 and print "My score is 85"</p>

  <input type="text" id="answer1" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer1', 'result1', 'score = 85; print(&quot;My score is 85&quot;)', true)">Submit</button>
  <div id="result1"></div>
</div>

<!-- Example 2 -->
<div class="card">
  <h2>Example 2: String Variables</h2>
  <p><strong>Example:</strong></p>
  <pre>city = "Lagos"
print("I live in", city)</pre>

  <p><strong>Question:</strong> Create a variable called <code>favorite_color</code> with value "blue" and print "My favorite color is blue"</p>

  <input type="text" id="answer2" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer2', 'result2', 'favorite_color = &quot;blue&quot;; print(&quot;My favorite color is blue&quot;)', true)">Submit</button>
  <div id="result2"></div>
</div>

<!-- Example 3 -->
<div class="card">
  <h2>Example 3: If Statement</h2>
  <p><strong>Example:</strong></p>
  <pre>temperature = 30
if temperature > 25:
    print("It's hot today")</pre>

  <p><strong>Question:</strong> Write an if statement that checks if a variable <code>grade</code> (with value 85) is greater than or equal to 70, and prints "You passed!"</p>

  <input type="text" id="answer3" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer3', 'result3', 'grade = 85; if grade >= 70: print(&quot;You passed!&quot;)', true)">Submit</button>
  <div id="result3"></div>
</div>

<!-- Example 4 -->
<div class="card">
  <h2>Example 4: For Loop</h2>
  <p><strong>Example:</strong></p>
  <pre>for i in range(3):
    print("Count:", i)</pre>

  <p><strong>Question:</strong> Write a for loop that prints numbers from 1 to 5 using range(1, 6)</p>

  <input type="text" id="answer4" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer4', 'result4', 'for i in range(1, 6): print(i)', true)">Submit</button>
  <div id="result4"></div>
</div>

<!-- Example 5 -->
<div class="card">
  <h2>Example 5: List Creation</h2>
  <p><strong>Example:</strong></p>
  <pre>colors = ["red", "green", "blue"]
print(colors[0])</pre>

  <p><strong>Question:</strong> Create a list called <code>fruits</code> with "apple", "banana", "orange" and print the second item (index 1)</p>

  <input type="text" id="answer5" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer5', 'result5', 'fruits = [&quot;apple&quot;, &quot;banana&quot;, &quot;orange&quot;]; print(fruits[1])', true)">Submit</button>
  <div id="result5"></div>
</div>

<!-- Example 6 -->
<div class="card">
  <h2>Example 6: Function Definition</h2>
  <p><strong>Example:</strong></p>
  <pre>def greet(name):
    return "Hello " + name</pre>

  <p><strong>Question:</strong> Write a function called <code>add_numbers</code> that takes two parameters and returns their sum</p>

  <input type="text" id="answer6" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer6', 'result6', 'def add_numbers(a, b): return a + b', true)">Submit</button>
  <div id="result6"></div>
</div>

<script>
  function checkAnswer(inputId, resultId, correctAnswer, isFlexible = false) {
    const userInput = document.getElementById(inputId).value.trim();
    const resultDiv = document.getElementById(resultId);
    let normalizedUserInput = userInput.replace(/\s+/g, '').toLowerCase();
    let normalizedCorrectAnswer = correctAnswer.replace(/\s+/g, '').toLowerCase();

    if (isFlexible) {
      let isCorrect = false;
      
      // Custom validation for each question
      if (inputId === 'answer1') {
        isCorrect = normalizedUserInput.includes('score=85') && normalizedUserInput.includes('print(') && normalizedUserInput.includes('myscore');
      } else if (inputId === 'answer2') {
        isCorrect = normalizedUserInput.includes('favorite_color="blue"') && normalizedUserInput.includes('print(') && normalizedUserInput.includes('myfavoritecolor');
      } else if (inputId === 'answer3') {
        isCorrect = normalizedUserInput.includes('grade=85') && normalizedUserInput.includes('ifgrade>=70:') && normalizedUserInput.includes('youpassed');
      } else if (inputId === 'answer4') {
        isCorrect = normalizedUserInput.includes('foriinrange(1,6):') && normalizedUserInput.includes('print(i)');
      } else if (inputId === 'answer5') {
        isCorrect = normalizedUserInput.includes('fruits=["apple","banana","orange"]') && normalizedUserInput.includes('print(fruits[1])');
      } else if (inputId === 'answer6') {
        isCorrect = normalizedUserInput.includes('defadd_numbers(') && normalizedUserInput.includes('returna+b');
      }
      
      if (isCorrect) {
        resultDiv.innerHTML = '<p class="correct">✅ Correct!</p>';
      } else {
        resultDiv.innerHTML = `<p class="incorrect">❌ Incorrect.</p><p>Hint: Check the example format and try again.</p>`;
      }
    } else {
      if (normalizedUserInput === normalizedCorrectAnswer) {
        resultDiv.innerHTML = '<p class="correct">✅ Correct!</p>';
      } else {
        resultDiv.innerHTML = `<p class="incorrect">❌ Incorrect.</p><p>The correct answer is: <code>${correctAnswer}</code></p>`;
      }
    }
  }
</script>