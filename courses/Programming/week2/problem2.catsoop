</question>

<question multiplechoice>
csq_prompt = 'Which of the following will print only EVEN numbers from 1 to 10?'
csq_options = ['for i in range(1,10): if i % 2 == 0: print(i)', 'for i in range(0,10): print(i)', 'for i in range(2,10): print(i)', 'for i in range(1,10,2): print(i)']
csq_soln = 'for i in range(1,10): if i % 2 == 0: print(i)'
csq_renderer = 'radio'
csq_npoints = 1
csq_soln_mode = "value"
</question>

<question multiplechoice>
