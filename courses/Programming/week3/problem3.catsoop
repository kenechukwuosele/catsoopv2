<python>
cs_content_header = "Control Structures Quiz and Practice Problems"
</python>


<style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      background: #f9f9f9;
    }
    .card {
      background: white;
      border: 1px solid #ccc;
      padding: 16px;
      margin-bottom: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .correct {
      color: green;
      font-weight: bold;
    }
    .incorrect {
      color: red;
      font-weight: bold;
    }
    input[type="text"] {
      width: 100%;
      padding: 8px;
      margin-top: 10px;
    }
    button {
      margin-top: 10px;
      padding: 8px 16px;
    }
  </style>


<!-- Example 1 -->
<div class="card">
  <h2>Example 1: Basic If Statement</h2>
  <p><strong>Example:</strong></p>
  <pre>age = 20
if age >= 18:
    print("You can vote")</pre>

  <p><strong>Question:</strong> Write an if statement that checks if a variable <code>temperature</code> (with value 30) is greater than 25, and prints "It's hot!"</p>

  <input type="text" id="answer1" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer1', 'result1', 'temperature = 30; if temperature > 25: print(&quot;It\'s hot!&quot;)', true)">Submit</button>
  <div id="result1"></div>
</div>

<!-- Example 2 -->
<div class="card">
  <h2>Example 2: If-Else Statement</h2>
  <p><strong>Example:</strong></p>
  <pre>score = 75
if score >= 70:
    print("Pass")
else:
    print("Fail")</pre>

  <p><strong>Question:</strong> Write an if-else statement that checks if a variable <code>number</code> (with value 15) is even. Print "Even" if true, "Odd" if false. (Hint: use <code>number % 2 == 0</code> to check if even)</p>

  <input type="text" id="answer2" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer2', 'result2', 'number = 15; if number % 2 == 0: print(&quot;Even&quot;); else: print(&quot;Odd&quot;)', true)">Submit</button>
  <div id="result2"></div>
</div>

<!-- Example 3 -->
<div class="card">
  <h2>Example 3: Multiple Conditions (elif)</h2>
  <p><strong>Example:</strong></p>
  <pre>grade = 85
if grade >= 90:
    print("A")
elif grade >= 80:
    print("B")
else:
    print("C")</pre>

  <p><strong>Question:</strong> Write an if-elif-else statement for a variable <code>time</code> (with value 14). Print "Morning" if time < 12, "Afternoon" if time < 18, otherwise "Evening"</p>

  <input type="text" id="answer3" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer3', 'result3', 'time = 14; if time < 12: print(&quot;Morning&quot;); elif time < 18: print(&quot;Afternoon&quot;); else: print(&quot;Evening&quot;)', true)">Submit</button>
  <div id="result3"></div>
</div>

<!-- Example 4 -->
<div class="card">
  <h2>Example 4: For Loop with Range</h2>
  <p><strong>Example:</strong></p>
  <pre>for i in range(3):
    print("Hello", i)</pre>

  <p><strong>Question:</strong> Write a for loop that prints numbers from 1 to 4 using <code>range(1, 5)</code></p>

  <input type="text" id="answer4" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer4', 'result4', 'for i in range(1, 5): print(i)', true)">Submit</button>
  <div id="result4"></div>
</div>

<!-- Example 5 -->
<div class="card">
  <h2>Example 5: For Loop with List</h2>
  <p><strong>Example:</strong></p>
  <pre>colors = ["red", "blue", "green"]
for color in colors:
    print("I like", color)</pre>

  <p><strong>Question:</strong> Write a for loop that iterates through a list <code>animals = ["cat", "dog", "bird"]</code> and prints each animal</p>

  <input type="text" id="answer5" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer5', 'result5', 'animals = [&quot;cat&quot;, &quot;dog&quot;, &quot;bird&quot;]; for animal in animals: print(animal)', true)">Submit</button>
  <div id="result5"></div>
</div>

<!-- Example 6 -->
<div class="card">
  <h2>Example 6: While Loop</h2>
  <p><strong>Example:</strong></p>
  <pre>count = 1
while count <= 3:
    print("Count:", count)
    count += 1</pre>

  <p><strong>Question:</strong> Write a while loop that starts with <code>num = 5</code> and prints the number while it's greater than 0, decreasing by 1 each time</p>

  <input type="text" id="answer6" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer6', 'result6', 'num = 5; while num > 0: print(num); num -= 1', true)">Submit</button>
  <div id="result6"></div>
</div>

<!-- Example 7 -->
<div class="card">
  <h2>Example 7: Logical Operators</h2>
  <p><strong>Example:</strong></p>
  <pre>age = 25
has_license = True
if age >= 18 and has_license:
    print("Can drive")</pre>

  <p><strong>Question:</strong> Write an if statement using <code>or</code> that checks if <code>day = "Saturday"</code> OR <code>day = "Sunday"</code>, and prints "Weekend!"</p>

  <input type="text" id="answer7" placeholder='Type your answer here'>
  <button onclick="checkAnswer('answer7', 'result7', 'day = &quot;Saturday&quot;; if day == &quot;Saturday&quot; or day == &quot;Sunday&quot;: print(&quot;Weekend!&quot;)', true)">Submit</button>
  <div id="result7"></div>
</div>

<script>
  function checkAnswer(inputId, resultId, correctAnswer, isFlexible = false) {
    const userInput = document.getElementById(inputId).value.trim();
    const resultDiv = document.getElementById(resultId);
    let normalizedUserInput = userInput.replace(/\s+/g, '').toLowerCase();
    let normalizedCorrectAnswer = correctAnswer.replace(/\s+/g, '').toLowerCase();

    if (isFlexible) {
      let isCorrect = false;
      
      // Custom validation for each question
      if (inputId === 'answer1') {
        isCorrect = normalizedUserInput.includes('temperature=30') && normalizedUserInput.includes('iftemperature>25:') && normalizedUserInput.includes('print("it\'shot!")');
      } else if (inputId === 'answer2') {
        isCorrect = normalizedUserInput.includes('number=15') && normalizedUserInput.includes('ifnumber%2==0:') && normalizedUserInput.includes('print("even")') && normalizedUserInput.includes('else:') && normalizedUserInput.includes('print("odd")');
      } else if (inputId === 'answer3') {
        isCorrect = normalizedUserInput.includes('time=14') && normalizedUserInput.includes('iftime<12:') && normalizedUserInput.includes('print("morning")') && normalizedUserInput.includes('eliftime<18:') && normalizedUserInput.includes('print("afternoon")') && normalizedUserInput.includes('else:') && normalizedUserInput.includes('print("evening")');
      } else if (inputId === 'answer4') {
        isCorrect = normalizedUserInput.includes('foriinrange(1,5):') && normalizedUserInput.includes('print(i)');
      } else if (inputId === 'answer5') {
        isCorrect = normalizedUserInput.includes('animals=["cat","dog","bird"]') && normalizedUserInput.includes('foranimalinanimals:') && normalizedUserInput.includes('print(animal)');
      } else if (inputId === 'answer6') {
        isCorrect = normalizedUserInput.includes('num=5') && normalizedUserInput.includes('whilenum>0:') && normalizedUserInput.includes('print(num)') && normalizedUserInput.includes('num-=1');
      } else if (inputId === 'answer7') {
        isCorrect = normalizedUserInput.includes('day="saturday"') && normalizedUserInput.includes('ifday=="saturday"orday=="sunday":') && normalizedUserInput.includes('print("weekend!")');
      }
      
      if (isCorrect) {
        resultDiv.innerHTML = '<p class="correct">✅ Correct!</p>';
      } else {
        resultDiv.innerHTML = `<p class="incorrect">❌ Incorrect.</p><p>Hint: Check the example format and try again. Make sure to include all parts of the code.</p>`;
      }
    } else {
      if (normalizedUserInput === normalizedCorrectAnswer) {
        resultDiv.innerHTML = '<p class="correct">✅ Correct!</p>';
      } else {
        resultDiv.innerHTML = `<p class="incorrect">❌ Incorrect.</p><p>The correct answer is: <code>${correctAnswer}</code></p>`;
      }
    }
  }
</script>