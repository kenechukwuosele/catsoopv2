<python>
cs_content_header = "Submission Queue"
cs_description = "View and manage quiz submissions"
</python>

<style>
    .queue-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }
    .queue-item {
        border: 1px solid #ddd;
        margin: 10px 0;
        padding: 15px;
        border-radius: 5px;
        background-color: #f9f9f9;
    }
    .queue-item.processing {
        background-color: #fff3cd;
        border-color: #ffeaa7;
    }
    .queue-item.completed {
        background-color: #d4edda;
        border-color: #c3e6cb;
    }
    .queue-item.error {
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }
    .queue-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }
    .status-pending { background-color: #6c757d; color: white; }
    .status-processing { background-color: #ffc107; color: black; }
    .status-completed { background-color: #28a745; color: white; }
    .status-error { background-color: #dc3545; color: white; }
    
    .empty-queue {
        text-align: center;
        color: #6c757d;
        padding: 40px;
        font-style: italic;
    }
    
    .refresh-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
    }
    .refresh-btn:hover {
        background-color: #0056b3;
    }
</style>

<div class="queue-container">
    <div class="queue-header">
        <h2>📋 Submission Queue</h2>
        <button class="refresh-btn" onclick="location.reload()">🔄 Refresh</button>
    </div>
    
    <div id="queueList">
        <div class="empty-queue">
            <h3>📥 No submissions in queue</h3>
            <p>Quiz submissions will appear here when students submit their answers.</p>
            <p>This queue system is integrated with the affect detection system to track student progress and emotional states during quiz submissions.</p>
        </div>
    </div>
</div>

<script>
// Simulated queue data - in a real system, this would come from the backend
const queueData = [
    {
        id: 1,
        student: "student1",
        quiz: "Programming Week 1 Quiz",
        status: "completed",
        submitted: "2026-03-28 10:30:00",
        processed: "2026-03-28 10:31:15",
        score: "9/10"
    },
    {
        id: 2,
        student: "student2", 
        quiz: "Programming Week 1 Quiz",
        status: "processing",
        submitted: "2026-03-28 10:45:00",
        processed: null,
        score: null
    }
];

function renderQueue() {
    const queueList = document.getElementById('queueList');
    
    if (queueData.length === 0) {
        return; // Keep the empty state
    }
    
    let html = '';
    queueData.forEach(item => {
        html += `
            <div class="queue-item ${item.status}">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong>${item.student}</strong> - ${item.quiz}
                        <br>
                        <small>Submitted: ${item.submitted}</small>
                        ${item.processed ? `<br><small>Processed: ${item.processed}</small>` : ''}
                        ${item.score ? `<br><small>Score: ${item.score}</small>` : ''}
                    </div>
                    <span class="status-badge status-${item.status}">${item.status}</span>
                </div>
                <div style="margin-top: 10px; font-size: 12px; color: #666;">
                    Queue ID: ${item.id}
                </div>
            </div>
        `;
    });
    
    queueList.innerHTML = html;
}

// Render the queue on page load
document.addEventListener('DOMContentLoaded', function() {
    // For now, show empty queue - in production this would fetch from API
    console.log('Queue page loaded');
    
    // If we want to show sample data, uncomment the line below:
    // renderQueue();
});
</script>